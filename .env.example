# Optional. Leave all of these unset for local development —
# the app then uses file SQLite at data/jobbot.sqlite.

# Remote libSQL / Turso (required on Vercel). Either name in each pair works.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
# LIBSQL_URL=libsql://your-db-your-org.turso.io
# LIBSQL_AUTH_TOKEN=
